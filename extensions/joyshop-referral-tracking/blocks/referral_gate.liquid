{% comment %}
  JOYSHOP Referral Gate

  - Reads ?ref=REFERRAL_CODE and saves it in a cookie (30 days)
  - Logs ONE visit per referral landing
  - Sends non-logged-in visitors to sign in / sign up
  - Keeps trying to link the referral until Shopify actually
    knows who the customer is (only then is it marked "linked")
  - Tells the welcome popup to show ONLY when a brand-new
    referral was created (not for existing customers)
  - Also powers the "Copy referral link" button on the
    ambassador dashboard (works independently of ?ref=)
{% endcomment %}

<script>
(function () {
  "use strict";

  const REF_PARAM = "ref";
  const COOKIE_NAME = "joyshop_ref";
  const COOKIE_DAYS = 30;
  const LINKED_KEY = "joyshop_referral_linked";
  const POST_LOGIN_REDIRECT_KEY = "joyshop_post_login_redirect";
  const FORCED_REFERRAL_LOGIN_KEY = "joyshop_forced_referral_login";
  const WELCOME_KEY = "jo_referral_welcome"; // read by referral-welcome-popup
  const WELCOME_EVENT = "joyshop:referral-welcome";

  /* =========================================================
     1. REFERRAL LINK COPY FUNCTIONALITY
  ========================================================= */

  function setupReferralCopy() {
    const referralBoxes = document.querySelectorAll(".referral-box");
    if (!referralBoxes.length) return;

    referralBoxes.forEach(function (box) {
      const button =
        box.querySelector("button.referral-copy-btn") ||
        box.querySelector("button");
      const input = box.querySelector('input[type="text"]');

      if (!button || !input) return;
      if (button.dataset.joyshopCopyReady === "true") return;

      button.dataset.joyshopCopyReady = "true";

      button.addEventListener("click", async function () {
        const originalText = button.innerText;
        const referralLink = input.value;

        if (!referralLink) return;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(referralLink);
          } else {
            input.focus();
            input.select();
            input.setSelectionRange(0, input.value.length);
            const successful = document.execCommand("copy");
            input.blur();
            if (!successful) throw new Error("Fallback copy failed");
          }

          button.innerText = "Copied!";
          setTimeout(function () { button.innerText = originalText; }, 2000);
        } catch (error) {
          console.error("JOYSHOP: Referral link copy failed:", error);
          button.innerText = "Copy failed";
          setTimeout(function () { button.innerText = originalText; }, 2000);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupReferralCopy);
  } else {
    setupReferralCopy();
  }

  new MutationObserver(setupReferralCopy).observe(document.documentElement, {
    childList: true,
    subtree: true,
  });

  /* =========================================================
     2. STORAGE HELPERS
  ========================================================= */

  function setReferralCookie(code) {
    if (!code) return;
    document.cookie =
      COOKIE_NAME + "=" + encodeURIComponent(code) +
      "; path=/; max-age=" + COOKIE_DAYS * 24 * 60 * 60 + "; SameSite=Lax";
  }

  function getReferralFromCookie() {
    const cookies = document.cookie.split(";");
    for (let i = 0; i < cookies.length; i++) {
      const cookie = cookies[i].trim();
      if (cookie.indexOf(COOKIE_NAME + "=") === 0) {
        return decodeURIComponent(cookie.substring(COOKIE_NAME.length + 1));
      }
    }
    return null;
  }

  function safeGet(storage, key) {
    try { return storage.getItem(key); } catch (e) { return null; }
  }

  function safeSet(storage, key, value) {
    try { storage.setItem(key, value); } catch (e) {}
  }

  function safeRemove(storage, key) {
    try { storage.removeItem(key); } catch (e) {}
  }

  /* =========================================================
     3. SERVER CALL
  ========================================================= */

  async function callTrack(code, logVisit) {
    if (!code) return null;

    try {
      const response = await fetch(
        "/apps/joyshop/ref/track?ref=" + encodeURIComponent(code) +
          (logVisit ? "&visit=1" : ""),
        {
          method: "GET",
          credentials: "same-origin",
          keepalive: true,
          cache: "no-store",
          headers: { Accept: "application/json" },
        }
      );

      const data = await response.json();
      console.log("JOYSHOP REFERRAL TRACK RESPONSE:", data);
      return data;
    } catch (error) {
      console.error("JOYSHOP REFERRAL TRACKING ERROR:", error);
      return null;
    }
  }

  /*
   * A referral is only "done" when the server resolved a real
   * logged-in customer. Anonymous responses (customerId: null)
   * and errors are NOT treated as linked, so we keep trying.
   */
  function handleLinkResult(code, data) {
    if (!data || !data.success || !data.customerId) return false;

    safeSet(localStorage, LINKED_KEY, code + ":" + data.customerId);

    if (data.isNewReferral) {
      safeSet(sessionStorage, WELCOME_KEY, code);
      window.dispatchEvent(new CustomEvent(WELCOME_EVENT, { detail: { code: code } }));
    }

    return true;
  }

  /* =========================================================
     4. MAIN FLOW
  ========================================================= */

  const params = new URLSearchParams(window.location.search);
  const referralCodeFromUrl = params.get(REF_PARAM);

  const isLoggedIn = {% if customer %}true{% else %}false{% endif %};
  const currentCustomerId = {% if customer %}"{{ customer.id }}"{% else %}null{% endif %};

  async function run() {
    if (isLoggedIn) {
      // Link first, THEN navigate, so the redirect can't cancel the request.
      await handleReferral();

      const pendingRedirect = safeGet(sessionStorage, POST_LOGIN_REDIRECT_KEY);
      safeRemove(sessionStorage, FORCED_REFERRAL_LOGIN_KEY);

      if (pendingRedirect) {
        safeRemove(sessionStorage, POST_LOGIN_REDIRECT_KEY);
        window.location.replace(pendingRedirect);
      }
      return;
    }

    handleReferral();
  }

  async function handleReferral() {
    /* ----- Case A: ?ref= in the URL (first landing) ----- */

    if (referralCodeFromUrl) {
      console.log("JOYSHOP: Referral code detected:", referralCodeFromUrl);

      setReferralCookie(referralCodeFromUrl);

      // A new link click starts fresh, even on a browser that was
      // linked before (e.g. a different family member).
      safeRemove(localStorage, LINKED_KEY);

      if (!isLoggedIn) {
        callTrack(referralCodeFromUrl, true); // keepalive survives the redirect
        redirectToSignIn();
        return;
      }

      const data = await callTrack(referralCodeFromUrl, true);
      handleLinkResult(referralCodeFromUrl, data);
      return;
    }

    /* ----- Case B: no ?ref=, but a referral cookie exists ----- */

    const code = getReferralFromCookie();
    if (!code) return;

    const linked = safeGet(localStorage, LINKED_KEY) || "";

    if (isLoggedIn) {
      if (linked === code + ":" + currentCustomerId) return; // already done

      console.log("JOYSHOP: Linking pending referral for logged-in customer:", code);
      const data = await callTrack(code, false);
      handleLinkResult(code, data);
      return;
    }

    // Not logged in on this page load.
    if (linked.indexOf(code + ":") === 0) return; // this browser already linked

    /*
     * Some OTP / login widgets log the customer in WITHOUT a page
     * reload, so this page's Liquid snapshot stays "not logged in".
     * Poll quietly (no visit logged) until Shopify reports a real
     * customer on the request, for up to ~2 minutes.
     */
    let attempts = 0;
    const maxAttempts = 40;

    const poll = setInterval(async function () {
      attempts++;

      const data = await callTrack(code, false);

      if (handleLinkResult(code, data) || attempts >= maxAttempts) {
        clearInterval(poll);
      }
    }, 3000);
  }

  function redirectToSignIn() {
    safeSet(sessionStorage, POST_LOGIN_REDIRECT_KEY, "/");
    safeSet(sessionStorage, FORCED_REFERRAL_LOGIN_KEY, "true");
    window.location.replace("/pages/account");
  }

  run();
})();
</script>

{% schema %}
{
  "name": "Referral Gate",
  "target": "body",
  "settings": []
}
{% endschema %}
