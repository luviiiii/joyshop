{% comment %}
  JOYSHOP Referral Gate

  - Reads ?ref=REFERRAL_CODE
  - Saves referral code in a cookie (30 days)
  - Tracks the visit via the JOYSHOP app (correct endpoint)
  - Forces non-logged-in visitors to sign in / create an account
    before they can continue, so the referral can be linked to
    their customer ID
  - Also powers the "Copy referral link" button on the
    ambassador dashboard (works independently of ?ref=)
{% endcomment %}

<script>
(function () {
  "use strict";

  const REF_PARAM = "ref";
  const COOKIE_NAME = "joyshop_ref";
  const COOKIE_DAYS = 30;
  const LINKED_KEY = "joyshop_referral_linked";
  const POST_LOGIN_REDIRECT_KEY = "joyshop_post_login_redirect";
  const FORCED_REFERRAL_LOGIN_KEY = "joyshop_forced_referral_login";

  /* =========================================================
     1. REFERRAL LINK COPY FUNCTIONALITY
     (works independently of ?ref=, used on ambassador dashboard)
  ========================================================= */

  function setupReferralCopy() {
    const referralBoxes = document.querySelectorAll(".referral-box");

    if (!referralBoxes.length) {
      return;
    }

    referralBoxes.forEach(function (box) {
      const button =
        box.querySelector("button.referral-copy-btn") ||
        box.querySelector("button");

      const input = box.querySelector('input[type="text"]');

      if (!button || !input) {
        return;
      }

      if (button.dataset.joyshopCopyReady === "true") {
        return;
      }

      button.dataset.joyshopCopyReady = "true";

      button.addEventListener("click", async function () {
        const originalText = button.innerText;
        const referralLink = input.value;

        if (!referralLink) {
          console.error("JOYSHOP: Referral link is empty.");
          return;
        }

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(referralLink);
          } else {
            input.focus();
            input.select();
            input.setSelectionRange(0, input.value.length);

            const successful = document.execCommand("copy");
            input.blur();

            if (!successful) {
              throw new Error("Fallback copy failed");
            }
          }

          button.innerText = "Copied!";
          button.setAttribute("aria-label", "Referral link copied");

          setTimeout(function () {
            button.innerText = originalText;
            button.setAttribute("aria-label", "Copy referral link");
          }, 2000);

        } catch (error) {
          console.error("JOYSHOP: Referral link copy failed:", error);

          button.innerText = "Copy failed";

          setTimeout(function () {
            button.innerText = originalText;
          }, 2000);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupReferralCopy);
  } else {
    setupReferralCopy();
  }

  const referralObserver = new MutationObserver(function () {
    setupReferralCopy();
  });

  referralObserver.observe(document.body, {
    childList: true,
    subtree: true,
  });

  /* =========================================================
     2. COOKIE HELPERS
  ========================================================= */

  function setReferralCookie(code) {
    if (!code) return;

    const maxAge = COOKIE_DAYS * 24 * 60 * 60;

    document.cookie =
      COOKIE_NAME +
      "=" +
      encodeURIComponent(code) +
      "; path=/" +
      "; max-age=" +
      maxAge +
      "; SameSite=Lax";
  }

  function getReferralFromCookie() {
    const cookies = document.cookie.split(";");

    for (let i = 0; i < cookies.length; i++) {
      const cookie = cookies[i].trim();

      if (cookie.indexOf(COOKIE_NAME + "=") === 0) {
        return decodeURIComponent(
          cookie.substring((COOKIE_NAME + "=").length)
        );
      }
    }

    return null;
  }

  /* =========================================================
     3. TRACK REFERRAL VISIT (correct endpoint)
  ========================================================= */

  async function trackReferralVisit(code) {
    if (!code) return null;

    try {
      const response = await fetch(
        "/apps/joyshop/ref/track?ref=" + encodeURIComponent(code),
        {
          method: "GET",
          credentials: "same-origin",
          keepalive: true,
          headers: {
            "Accept": "application/json",
          },
        }
      );

      const data = await response.json();

      console.log("JOYSHOP REFERRAL TRACK RESPONSE:", data);

      return data;

    } catch (error) {
      console.error("JOYSHOP REFERRAL TRACKING ERROR:", error);
      return null;
    }
  }

  /* =========================================================
     4. MAIN REFERRAL FLOW
  ========================================================= */

  const params = new URLSearchParams(window.location.search);
  const referralCodeFromUrl = params.get(REF_PARAM);

  const isLoggedIn =
    {% if customer %}
      true
    {% else %}
      false
    {% endif %};

  /*
   * If the customer is now logged in AND we stashed a
   * post-login redirect destination before sending them to
   * sign in/sign up, honor it now and clear the flag so this
   * only fires once (not on every subsequent page load).
   */
  if (isLoggedIn) {
    const pendingRedirect = sessionStorage.getItem(POST_LOGIN_REDIRECT_KEY);

    sessionStorage.removeItem(FORCED_REFERRAL_LOGIN_KEY);

    if (pendingRedirect) {
      sessionStorage.removeItem(POST_LOGIN_REDIRECT_KEY);

      console.log(
        "JOYSHOP: Redirecting after login to:",
        pendingRedirect
      );

      window.location.replace(pendingRedirect);
    }
  }

  async function handleReferral() {

    /* ----- Case A: ?ref= present in the URL ----- */

    if (referralCodeFromUrl) {
      console.log("JOYSHOP: Referral code detected:", referralCodeFromUrl);

      setReferralCookie(referralCodeFromUrl);

      if (!isLoggedIn) {
        /*
         * Fire the visit-tracking request in the background
         * (keepalive keeps it alive through the immediate
         * navigation below) and redirect to sign-in right away,
         * instead of making the visitor wait on this network
         * round-trip first. The cookie above already preserves
         * the referral even if this call is still in flight.
         */
        trackReferralVisit(referralCodeFromUrl);
        redirectToSignIn();
        return;
      }

      /*
       * Already logged in — this call also creates the
       * Referral record server-side, so we do wait for it here.
       */
      await trackReferralVisit(referralCodeFromUrl);

      localStorage.setItem(LINKED_KEY, referralCodeFromUrl);
      return;
    }

    /* ----- Case B: no ?ref=, but a cookie exists ----- */

    const existingReferral = getReferralFromCookie();

    if (!existingReferral) {
      return;
    }

    const alreadyLinked = localStorage.getItem(LINKED_KEY);

    if (alreadyLinked === existingReferral) {
      return;
    }

    if (!isLoggedIn) {
      /*
       * Don't force a redirect on every single page view for
       * an existing cookie visitor — only the initial ?ref=
       * click forces sign-in. Once they choose to log in on
       * their own, the block below links the referral.
       */
      return;
    }

    console.log(
      "JOYSHOP: Logged-in customer with pending referral cookie:",
      existingReferral
    );

    const data = await trackReferralVisit(existingReferral);

    if (data && data.success) {
      localStorage.setItem(LINKED_KEY, existingReferral);
    }
  }

  function redirectToSignIn() {
    /*
     * We use sessionStorage rather than a URL query param
     * here, since Shopify's hosted sign-in/sign-up flow runs
     * on a separate domain and may not reliably preserve
     * arbitrary custom query params through that round-trip.
     * sessionStorage persists across that redirect as long as
     * it's the same browser tab, regardless of what happens
     * on Shopify's side.
     */
    sessionStorage.setItem(POST_LOGIN_REDIRECT_KEY, "/");
    sessionStorage.setItem(FORCED_REFERRAL_LOGIN_KEY, "true");

    const loginUrl = "/pages/account";

    console.log("JOYSHOP: Redirecting to sign in:", loginUrl);

    window.location.replace(loginUrl);
  }

  handleReferral();

})();
</script>

{% schema %}
{
  "name": "Referral Gate",
  "target": "body",
  "settings": []
}
{% endschema %}
