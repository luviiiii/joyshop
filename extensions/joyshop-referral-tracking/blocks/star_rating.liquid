{% comment %}
  JOYSHOP Referral Tracking

  Reads ?ref=REFERRAL_CODE
  Saves the referral code in a browser cookie
  and sends the visit to the JOYSHOP app.
{% endcomment %}

<script>
(function () {
  "use strict";

  const REF_PARAM = "ref";
  const COOKIE_NAME = "joyshop_ref";
  const COOKIE_DAYS = 30;

  function setReferralCookie(code) {
    if (!code) return;

    const maxAge = COOKIE_DAYS * 24 * 60 * 60;

    document.cookie =
      COOKIE_NAME +
      "=" +
      encodeURIComponent(code) +
      "; path=/" +
      "; max-age=" +
      maxAge +
      "; SameSite=Lax";

    console.log("JOYSHOP REFERRAL SAVED:", code);
  }

  function getReferralFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get(REF_PARAM);
  }

  function getReferralFromCookie() {
    const cookies = document.cookie.split(";");

    for (let i = 0; i < cookies.length; i++) {
      const cookie = cookies[i].trim();

      if (cookie.indexOf(COOKIE_NAME + "=") === 0) {
        return decodeURIComponent(
          cookie.substring((COOKIE_NAME + "=").length)
        );
      }
    }

    return null;
  }

  async function trackReferralVisit(code) {
    if (!code) return;

    try {
      const response = await fetch(
        "/apps/joyshop/ref/track?ref=" +
          encodeURIComponent(code),
        {
          method: "GET",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json"
          }
        }
      );

      if (!response.ok) {
        console.error(
          "JOYSHOP REFERRAL TRACKING FAILED:",
          response.status
        );
        return;
      }

      const data = await response.json();

      console.log(
        "JOYSHOP REFERRAL VISIT TRACKED:",
        data
      );

    } catch (error) {
      console.error(
        "JOYSHOP REFERRAL TRACKING ERROR:",
        error
      );
    }
  }

  function cleanUrl() {
    const url = new URL(window.location.href);

    if (!url.searchParams.has(REF_PARAM)) {
      return;
    }

    url.searchParams.delete(REF_PARAM);

    window.history.replaceState(
      {},
      document.title,
      url.pathname +
        (url.search ? url.search : "") +
        (url.hash ? url.hash : "")
    );
  }

  async function trackReferral() {
    const referralCode = getReferralFromUrl();

    if (referralCode) {

      console.log(
        "JOYSHOP REFERRAL DETECTED:",
        referralCode
      );

      setReferralCookie(referralCode);

      /*
       * Send the visit to the JOYSHOP app.
       */
      await trackReferralVisit(referralCode);

      /*
       * Remove ?ref= from the browser URL
       * after tracking.
       */
      cleanUrl();

      return;
    }

    const existingReferral = getReferralFromCookie();

    if (existingReferral) {
      console.log(
        "JOYSHOP EXISTING REFERRAL:",
        existingReferral
      );
    }
  }

  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      trackReferral
    );

  } else {

    trackReferral();

  }

})();
</script>

{% schema %}
{
  "name": "JOYSHOP Referral Tracking",
  "target": "body",
  "settings": []
}
{% endschema %}